# Server port
PORT=4315

# Any OpenAI-compatible endpoint (OpenAI, Ollama, LiteLLM, Anthropic, etc.)
# Note the /v1 suffix required by most OpenAI-compatible providers
GATEWAY_BASE_URL=https://api.openai.com/v1
GATEWAY_API_KEY=''

# Model ID supported by your endpoint (e.g. gpt-4o-mini, claude-sonnet-4-6, llama3.2)
CHAT_MODEL=gpt-4o-mini

# Max context tokens passed to the model
CHAT_CONTEXT_LIMIT=200000

# Max agentic tool-calling rounds per turn
MAX_TOOL_ROUNDS=8

# Directory containing skill markdown files for the use_skill tool
SKILLS_DIR=./skills

# Root directory for the read_file / search_files tools.
# Point this at any markdown knowledge base you want the AI to search.
# Defaults to SKILLS_DIR. Files outside this directory are rejected.
CONTENT_DIR=./skills

# Extended thinking level: disabled | low | medium | high
# Server-side fallback when the client doesn't specify a level.
# Thinking only works with Claude 3.7+ via an Anthropic-compatible gateway.
THINKING_DEFAULT_LEVEL=disabled

# Comma-separated list of model IDs the client may select.
# Defaults to CHAT_MODEL only. Add multiple to enable the model picker in Settings.
# Example: ALLOWED_MODELS=gpt-4o-mini,gpt-4o,o3-mini
ALLOWED_MODELS=

# Rate limiting for POST /api/chat (per IP, sliding window).
# Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# How many reverse proxies you control sit in front of this server. The rate
# limiter counts back this many entries from the end of X-Forwarded-For, since
# only proxy-appended entries are trustworthy — anything a client sends is not.
#   0 = nothing proxies this server (every caller is keyed as "unknown", so the
#       per-IP limit becomes one shared global limit)
#   1 = one ALB / nginx / Cloudflare in front (the default)
#   2 = e.g. Cloudflare then your own ALB
# Too high trusts a client-supplied value; too low throttles all callers as one.
TRUSTED_PROXY_HOPS=1

# Set to false to switch the chat feature off. The API still answers, with a stub
# router that explains why, so the client does not fail mid-stream.
CHAT_ENABLED=true

# Request size caps, checked before any model call. The defaults below are abuse
# backstops, sized so that pasting a whole source file into a turn still works.
# A deployment open to anonymous visitors should tighten them by roughly an order
# of magnitude. Leave blank to use the defaults.
CHAT_MAX_MESSAGE_CHARS=100000
CHAT_MAX_TOTAL_CHARS=1000000
CHAT_MAX_MESSAGES=500
